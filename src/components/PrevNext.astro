---
interface Item { href: string; title: string }
interface Props {
  prev?: Item;
  next?: Item;
  prevLabel: string;
  nextLabel: string;
  label: string;
}
const { prev, next, prevLabel, nextLabel, label } = Astro.props;
---

<nav class="pn wrap" aria-label={label}>
  <div class="pn__inner">
    {
      prev ? (
        <a class="pn__item pn__item--prev" href={prev.href} rel="prev">
          <span class="label muted">← {prevLabel}</span>
          <span class="pn__title">{prev.title}</span>
        </a>
      ) : <span />
    }
    {
      next ? (
        <a class="pn__item pn__item--next" href={next.href} rel="next">
          <span class="label muted">{nextLabel} →</span>
          <span class="pn__title">{next.title}</span>
        </a>
      ) : <span />
    }
  </div>
</nav>

<style>
  .pn { padding-block: clamp(3rem, 6vw, 5rem); }
  .pn__inner {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line-strong);
  }
  .pn__item {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.5rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .pn__title {
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    transition: transform 0.8s var(--ease-out);
  }
  .pn__item--prev:hover .pn__title { transform: translateX(-0.35rem); }
  .pn__item--next:hover .pn__title { transform: translateX(0.35rem); }
  @media (min-width: 700px) {
    .pn__inner { grid-template-columns: 1fr 1fr; gap: var(--col-gap); }
    .pn__item { border-bottom: 0; padding-block: 1.75rem 0; }
    .pn__item--next { text-align: right; justify-items: end; }
  }
</style>
