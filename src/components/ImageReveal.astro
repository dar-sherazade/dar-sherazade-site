---
/**
 * Responsive, optimised image with an optional mask reveal on scroll
 * and an optional museum-label caption.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Tells the browser how wide the image is displayed, e.g. "50vw". */
  sizes?: string;
  /** Crop ratio, e.g. "4 / 5". Defaults to the photograph's own ratio. */
  ratio?: string;
  /** Focal point for cropping, e.g. "50% 20%". */
  position?: string;
  /** Load immediately (use only for the first image on a page). */
  eager?: boolean;
  reveal?: boolean;
  delay?: number;
  caption?: string;
  /** Caption set vertically beside the image on large screens. */
  captionSide?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = '(min-width: 900px) 50vw, 100vw',
  ratio,
  position = '50% 50%',
  eager = false,
  reveal = true,
  delay = 0,
  caption,
  captionSide = false,
  class: className,
} = Astro.props;

const candidates = [480, 720, 1080, 1440, 1920, 2400];
let widths = candidates.filter((w) => w < src.width);
widths.push(src.width);
widths = [...new Set(widths)];
const aspect = ratio ?? `${src.width} / ${src.height}`;
---

<figure class:list={['ir', captionSide && 'ir--side', className]}>
  <div class:list={['ir__frame frame', reveal && 'reveal-image']} style={`aspect-ratio: ${aspect}; --delay: ${delay}s;`}>
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['webp']}
      quality={80}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
      style={`object-position: ${position};`}
    />
  </div>
  {caption && <figcaption class="ir__caption meta">{caption}</figcaption>}
</figure>

<style>
  .ir { position: relative; }
  .ir__frame :global(picture) { display: contents; }
  .ir__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ir__caption {
    margin-top: 0.85rem;
    max-width: 28rem;
  }
  @media (min-width: 900px) {
    .ir--side .ir__caption {
      position: absolute;
      top: 0;
      left: calc(100% + 1rem);
      margin: 0;
      writing-mode: vertical-rl;
      max-height: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
