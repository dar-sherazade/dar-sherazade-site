---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import { t } from '../i18n/en';
---

<BaseLayout title={t.notFound.title} noindex>
  <section class="wrap not-found">
    <p class="label muted">404</p>
    <h1 class="h1">{t.notFound.title}</h1>
    <p class="lede">{t.notFound.text}</p>
    <p>
      <a class="arrow-link" href={url('/')}><span>{t.notFound.link}</span><span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70svh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding-block: var(--section-sm);
  }
</style>
