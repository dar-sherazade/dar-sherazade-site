---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, emailIsPlaceholder } from '../config';
import { t } from '../i18n/en';
---

<BaseLayout title={t.contact.title} description={t.contact.intro}>
  <header class="page-head wrap">
    <p class="label reveal">{siteConfig.name}</p>
    <h1 class="h1 page-head__title reveal">{t.contact.title}</h1>
    <p class="lede page-head__intro reveal" style="--delay: .1s">{t.contact.intro}</p>
  </header>

  <section class="wrap contact" aria-label={t.contact.title}>
    <dl class="contact__list">
      <div class="contact__row reveal">
        <dt class="label muted">{t.instagram}</dt>
        <dd>
          <a class="contact__value link link--quiet" href={siteConfig.instagramUrl} rel="me noopener" target="_blank">
            {siteConfig.instagramHandle}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </dd>
      </div>
      <div class="contact__row reveal" style="--delay: .08s">
        <dt class="label muted">{t.email}</dt>
        <dd>
          {
            emailIsPlaceholder ? (
              <span class="contact__value placeholder-text">{siteConfig.email}</span>
            ) : (
              <a class="contact__value link link--quiet" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            )
          }
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .contact { padding-top: clamp(2rem, 5vw, 4rem); padding-bottom: var(--section); }
  .contact__list { border-top: 1px solid var(--line-strong); }
  .contact__row {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--line);
  }
  .contact__value {
    font-size: clamp(2rem, 5.5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  @media (min-width: 900px) {
    .contact__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: baseline;
    }
    .contact__row dt { grid-column: 1 / span 3; }
    .contact__row dd { grid-column: 4 / -1; }
  }
</style>
