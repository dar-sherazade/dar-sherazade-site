---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import KaftanCard from '../components/KaftanCard.astro';
import ImageReveal from '../components/ImageReveal.astro';
import { Picture } from 'astro:assets';
import { getKaftans } from '../lib/content';
import { siteConfig } from '../config';
import { url } from '../lib/url';
import { t } from '../i18n/en';

// Homepage images — replace these files to change them.
import banner from '../assets/about/story-friends-01.jpg';
import teacup from '../assets/home/teacup.jpg';
import courtyard2 from '../assets/home/courtyard-02.jpg';
import courtyard3 from '../assets/home/courtyard-03.jpg';

const bannerAlt =
  'Four women gathered together in a tiled interior with a brass clock and candelabra, wearing ivory, powder-blue, mauve and coral kaftans.';
const teacupAlt =
  'A woman in a beaded ivory and gold kaftan holds a small patterned teacup, against a backdrop of blue zellige tiles.';
const courtyard2Alt =
  'Two women in the courtyard, one in a green and gold brocade kaftan and one in a black and turquoise kaftan, each holding a lantern in front of her face.';
const courtyard3Alt =
  'Two women standing back to back in front of a carved cedar door, both in lilac sequinned kaftans.';

const kaftans = await getKaftans();
const featured = kaftans.filter((k) => k.data.featured).slice(0, 4);
---

<BaseLayout>
  <!-- Hero: the Dar Sherazade banner -->
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">{siteConfig.name}</h1>
    <div class="hero__banner frame">
      <Picture
        src={banner}
        alt={bannerAlt}
        widths={[640, 1050, 1440, 2100]}
        sizes="100vw"
        formats={['webp']}
        fallbackFormat="webp"
        quality={84}
        loading="eager"
        fetchpriority="high"
        style="object-position: 50% 52%;"
      />
    </div>
  </section>

  <!-- Introduction -->
  <section id="intro" class="section intro" aria-label="Introduction">
    <div class="wrap grid intro__grid">
      <div class="intro__text">
        <p class="label intro__label reveal">{siteConfig.name}</p>
        <p class="statement intro__statement reveal">{t.home.introStatement}</p>
        <div class="intro__body body-text reveal" style="--delay: .15s">
          {t.home.introBody.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="intro__image">
        <ImageReveal src={teacup} alt={teacupAlt} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- Featured pieces: a standard line-up -->
  <section class="section section--flush-top featured" aria-labelledby="featured-title">
    <div class="wrap">
      <SectionHeading
        eyebrow={t.home.archiveEyebrow}
        title={t.home.archiveTitle}
        id="featured-title"
        link={{ href: url('/archive/'), label: t.home.archiveLink }}
      />
      <div class="lineup">
        {
          featured.map((entry, i) => (
            <KaftanCard entry={entry} sizes="(min-width: 900px) 24vw, 46vw" delay={i * 0.08} class="lineup__item" />
          ))
        }
      </div>
      <p class="section-end reveal">
        <a class="arrow-link" href={url('/archive/')}>
          <span>{t.home.archiveLink}</span><span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- Courtyard diptych and quote -->
  <section class="quote on-dark" aria-label="The courtyard series">
    <div class="wrap">
      <div class="diptych">
        <ImageReveal src={courtyard2} alt={courtyard2Alt} sizes="(min-width: 700px) 46vw, 100vw" />
        <ImageReveal src={courtyard3} alt={courtyard3Alt} sizes="(min-width: 700px) 46vw, 100vw" delay={0.12} class="diptych__second" />
      </div>
      <div class="grid quote__text">
        <blockquote class="quote__body reveal">
          <p>{t.home.quote}</p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section about-teaser" aria-labelledby="about-title">
    <div class="wrap grid">
      <p class="label about-teaser__label reveal">{t.home.aboutEyebrow}</p>
      <div class="about-teaser__body">
        <h2 id="about-title" class="statement reveal">{t.home.aboutText}</h2>
        <ul class="about-teaser__links reveal" role="list">
          <li>
            <a class="arrow-link" href={url('/about/')}>
              <span>{t.home.aboutLink}</span><span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="arrow-link" href={siteConfig.instagramUrl} rel="me noopener" target="_blank">
              <span>Instagram {siteConfig.instagramHandle}</span><span class="arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero__banner {
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: calc(100svh - var(--header-h) - 6rem);
    min-height: 15rem;
    animation: mask-down 1.6s var(--ease-out) 0.05s both;
  }
  @media (min-width: 700px) {
    .hero__banner { aspect-ratio: 4 / 5; }
  }
  .hero__banner :global(picture) { display: contents; }
  .hero__banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: settle 2.4s var(--ease-out) 0.05s both;
  }

  /* ---------- Intro ---------- */
  .intro__grid { row-gap: 3rem; align-items: center; }
  .intro__text, .intro__image { grid-column: 1 / -1; }
  .intro__statement { margin-top: 1.5rem; max-width: 22ch; }
  .intro__body { margin-top: 2rem; color: var(--ink-soft); }
  .intro__image { max-width: 34rem; }
  @media (min-width: 900px) {
    .intro__text { grid-column: 1 / span 6; }
    .intro__image { grid-column: 8 / span 5; max-width: none; }
  }

  /* ---------- Featured line-up ---------- */
  .lineup {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--col-gap);
    align-items: start;
  }
  .lineup > :global(.lineup__item:nth-child(even)) { margin-top: 3rem; }
  @media (min-width: 900px) {
    .lineup { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .lineup > :global(.lineup__item:nth-child(even)) { margin-top: 5rem; }
  }
  .section-end { margin-top: clamp(3rem, 6vw, 5rem); }

  /* ---------- Courtyard diptych + quote ---------- */
  .quote { padding-block: clamp(4rem, 9vw, 8rem); }
  .diptych { display: grid; gap: var(--col-gap); }
  @media (min-width: 700px) {
    .diptych { grid-template-columns: 1fr 1fr; align-items: start; }
    .diptych :global(.diptych__second) { margin-top: clamp(3rem, 8vw, 8rem); }
  }
  .quote__text { margin-top: clamp(3rem, 7vw, 6rem); row-gap: 1.5rem; }
  .quote__body {
    grid-column: 1 / -1;
    font-size: clamp(2.75rem, 7.6vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-style: italic;
    max-width: 14ch;
  }
  @media (min-width: 900px) {
    .quote__body { grid-column: 1 / -1; }
  }

  /* ---------- About ---------- */
  .about-teaser .grid { row-gap: 2rem; }
  .about-teaser__label { grid-column: 1 / -1; }
  .about-teaser__body { grid-column: 1 / -1; }
  .about-teaser__body h2 { max-width: 24ch; }
  .about-teaser__links {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
  }
  @media (min-width: 900px) {
    .about-teaser__label { grid-column: 1 / span 3; padding-top: 0.9rem; }
    .about-teaser__body { grid-column: 4 / -1; }
  }
</style>
