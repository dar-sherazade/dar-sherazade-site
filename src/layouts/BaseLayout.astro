---
/**
 * Base page layout: <head> metadata (SEO, Open Graph, Twitter/X),
 * fonts, header, footer and the small site script.
 */
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/animations.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import { url } from '../lib/url';
import { t } from '../i18n/en';

interface Props {
  /** Page title, without the site name. Leave empty on the homepage. */
  title?: string;
  description?: string;
  /** Image used for link previews (Open Graph / Twitter). */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** "overlay" = transparent header over the hero (homepage). */
  headerMode?: 'overlay' | 'solid';
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  jsonLd,
  headerMode = 'solid',
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} — ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.tagline.replace(/\.$/, '')}`;

const site = Astro.site ?? new URL(siteConfig.siteUrl);
const canonical = new URL(Astro.url.pathname, site).href;

let ogImage = new URL(url('/social/og-default.jpg'), site).href;
let ogAlt = imageAlt ?? `${siteConfig.name} — ${siteConfig.tagline}`;
if (image) {
  const optimised = await getImage({ src: image, width: 1200, format: 'jpg', quality: 82 });
  ogImage = new URL(optimised.src, site).href;
}

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: new URL(url('/'), site).href,
    description: siteConfig.description,
    inLanguage: siteConfig.locale,
    sameAs: [siteConfig.instagramUrl],
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the animation script cannot run, show everything.
      window.__revealSafety = setTimeout(function () { document.documentElement.classList.add('reveal-all'); }, 2500);
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f3eee6" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" href={url('/favicon/favicon-32.png')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/favicon/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteConfig.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-header-mode={headerMode}>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header mode={headerMode} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
